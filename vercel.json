{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run ci",
  "installCommand": "pnpm install",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview": true
    }
  },
  "crons": [
    {
      "path": "/api/payload-jobs/run",
      "schedule": "*/10 * * * *"
    }
  ]
}
