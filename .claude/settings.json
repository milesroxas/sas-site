{
  "enabledPlugins": {
    "pmndrs@pmndrs": true,
    "vercel@claude-plugins-official": true,
    "paper-desktop@paper": true
  },
  "extraKnownMarketplaces": {
    "pmndrs": {
      "source": {
        "source": "github",
        "repo": "pmndrs/claude-code-plugin"
      }
    },
    "paper": {
      "source": {
        "source": "github",
        "repo": "paper-design/agent-plugins"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx\" \"${CLAUDE_PROJECT_DIR}/scripts/lab-journal/hook.ts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx\" \"${CLAUDE_PROJECT_DIR}/scripts/lab-journal/hook.ts\"",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx\" \"${CLAUDE_PROJECT_DIR}/scripts/lab-journal/hook.ts\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/tsx\" \"${CLAUDE_PROJECT_DIR}/scripts/lab-journal/hook.ts\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
