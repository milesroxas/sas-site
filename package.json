{
  "name": "with-vercel-website",
  "version": "1.0.0",
  "description": "Website template for Payload",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --no-server-fast-refresh -p 3001",
    "dev:tui": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/dev-tui/index.tsx",
    "email": "cross-env NODE_OPTIONS=--no-deprecation email dev --dir src/shared/email/templates --port 3000",
    "dev:prod": "cross-env NODE_OPTIONS=--no-deprecation rm -rf .next && pnpm build && pnpm start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-status-prod.ts",
    "check:migrations": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-migration-enum-safety.ts",
    "check:migrations:drift": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/check-migration-drift.ts",
    "ii": "cross-env NODE_OPTIONS=--no-deprecation pnpm install",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "reinstall": "cross-env NODE_OPTIONS=--no-deprecation rm -rf node_modules && rm pnpm-lock.yaml && pnpm install",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/seed/index.ts",
    "seed:drop": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env scripts/seed/index.ts --drop",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "chromatic": "cross-env NODE_OPTIONS=--no-deprecation chromatic --build-script-name=storybook:build",
    "storybook": "cross-env NODE_OPTIONS=--no-deprecation storybook dev -p 6006",
    "storybook:build": "cross-env NODE_OPTIONS=--no-deprecation storybook build",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=--no-deprecation playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "ci": "payload migrate && pnpm build",
    "db:up": "docker compose up postgres -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up postgres -d",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.23",
    "@ai-stack/payloadcms": "^3.2.30",
    "@c15t/nextjs": "^2.1.0",
    "@gsap/react": "^2.1.2",
    "@next/third-parties": "^16.2.10",
    "@payloadcms/admin-bar": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-vercel-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "3.88.0",
    "@payloadcms/plugin-mcp": "3.88.0",
    "@payloadcms/plugin-nested-docs": "3.88.0",
    "@payloadcms/plugin-redirects": "3.88.0",
    "@payloadcms/plugin-search": "3.88.0",
    "@payloadcms/plugin-sentry": "3.88.0",
    "@payloadcms/plugin-seo": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "catalog:",
    "@shadcn/react": "^0.2.1",
    "@sitebytom/payload-media-gallery": "^1.2.0",
    "@tabler/icons-react": "^3.44.0",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "embla-carousel-react": "^8.6.0",
    "ffmpeg-static": "^5.3.0",
    "geist": "^1.7.2",
    "graphql": "^16.14.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "leva": "^0.10.1",
    "next": "16.2.9",
    "next-sitemap": "^4.2.3",
    "payload": "3.88.0",
    "posthog-js": "^1.399.2",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "^6.6.5",
    "react-hook-form": "7.80.0",
    "resend": "^6.17.2",
    "sharp": "0.34.5",
    "svix": "^1.96.1",
    "tailwind-merge": "^3.6.0",
    "tempus": "1.0.0-dev.18",
    "three": "0.182.0",
    "tunnel-rat": "^0.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.2",
    "@types/escape-html": "^1.0.4",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "@vitejs/plugin-react": "6.0.3",
    "chromatic": "^18.0.1",
    "execa": "^9.6.1",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "jsdom": "29.1.1",
    "postcss": "^8.5.15",
    "schema-dts": "^2.0.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "^8.1.3",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "publishConfig": {
    "types": ".design-sync/entry.ts"
  }
}
