# Database — local Docker Postgres (pnpm db:up): port 54320, database payload
# Use `postgres@host` with no `:password` when using trust auth; `postgres:@host` breaks node-pg (SCRAM password error).
POSTGRES_URL=postgresql://postgres@127.0.0.1:54320/payload
# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Used to configure CORS, format links and more. No trailing slash (optional on Vercel — VERCEL_URL is used when unset)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Vercel Blob — required for media uploads in production when using @payloadcms/storage-vercel-blob
BLOB_READ_WRITE_TOKEN=
# Secret used to authenticate the Payload jobs runner (/api/payload-jobs/run) — sent as a Bearer
# token by the daily Vercel cron backstop AND the every-10-min GitHub Actions workflow
# (.github/workflows/payload-jobs.yml); the CRON_SECRET repo secret on GitHub must match this.
CRON_SECRET=YOUR_CRON_SECRET_HERE
# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
# Resend email — API key from https://resend.com/api-keys
RESEND_API_KEY=
# From address must be on a Resend-verified domain
RESEND_FROM_ADDRESS=noreply@yourdomain.com
RESEND_FROM_NAME=Suits & Sandals
# Public base URL email templates load images from (e.g. Vercel Blob store serving /email/logo.png).
# Email clients fetch images from the recipient's machine, so localhost never works — without this,
# logos fall back to NEXT_PUBLIC_SERVER_URL and break for emails sent from local dev.
EMAIL_ASSET_BASE_URL=
# Chromatic — project token for publishing Storybook (https://www.chromatic.com)
CHROMATIC_PROJECT_TOKEN=
# Svix signing secret for the Resend webhook endpoint (/api/newsletter/webhooks/resend) —
# create the webhook in Resend (events: email.bounced, email.complained) and paste its secret
RESEND_WEBHOOK_SECRET=
# Optional newsletter-specific sender (e.g. news@ on a marketing subdomain); falls back to RESEND_FROM_*
NEWSLETTER_FROM_ADDRESS=
NEWSLETTER_FROM_NAME=
# OpenAI key for the /api/ask RAG endpoint (Vercel AI SDK): answer model + content embeddings.
# Endpoint answers 503 when unset; publish-time embedding sync is skipped (run
# scripts/backfill-ask-index.ts after setting it).
OPENAI_API_KEY=
# c15t consent backend URL (https://<instance>.c15t.dev from a consent.io instance) —
# unset = offline mode: consent stored in browser only, no audit trail or geo targeting
NEXT_PUBLIC_C15T_URL=

# Sentry — error monitoring, tracing, session replay (https://sentry.io)
# DSN from Project Settings → Client Keys; SDK is disabled when unset.
# Environment separation (production/preview) is automatic via VERCEL_ENV.
NEXT_PUBLIC_SENTRY_DSN=
# Org/project slugs + auth token (org token, project:releases scope) enable
# source map upload at build time — set these in Vercel, not locally.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# PostHog — product analytics (https://posthog.com). Project API key (phc_...);
# disabled when unset. Events flow through the first-party /ingest proxy and
# only after the visitor grants the "measurement" consent category.
NEXT_PUBLIC_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com — set https://eu.i.posthog.com for EU cloud.
NEXT_PUBLIC_POSTHOG_HOST=

# Google Analytics 4 — measurement ID (G-...); disabled when unset. Loads only
# after "measurement" consent. Use a separate GA property/ID for preview (or
# leave it unset there) via Vercel per-environment values.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# IndexNow key (8–128 chars of a-z A-Z 0-9 and dashes, e.g. `openssl rand -hex 16`) — served at
# /indexnow.txt and used to ping Bing/Copilot, Yandex, Naver on publish. Submissions only fire
# when VERCEL_ENV=production, so this is safe to set everywhere; unset disables IndexNow.
INDEXNOW_KEY=
