{
  // design-sync build only (cfg.tsconfig). Two jobs:
  //  1. map next/image to the interop shim (see next-image-shim.ts);
  //  2. resolve the repo's aliases for the converter's paths plugin.
  // That plugin returns the first existing candidate and tries the bare path
  // before /index.*, so a directory import would resolve to the directory
  // itself and fail. Every alias that names a directory is therefore listed
  // explicitly, before the `@/*` wildcard, pointing at its index file.
  // Regenerate by re-running the scan in NOTES.md if new directories appear.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
          "next/image": [
                "./next-image-shim.ts"
          ],
          "@/components/AdminBar": [
                "../src/components/AdminBar/index.tsx"
          ],
          "@/components/Card": [
                "../src/components/Card/index.tsx"
          ],
          "@/components/CollectionArchive": [
                "../src/components/CollectionArchive/index.tsx"
          ],
          "@/components/GlobalCanvasRoot": [
                "../src/components/GlobalCanvasRoot/index.tsx"
          ],
